    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "i18next": "^26.4.2",
    "js-yaml": "^5.4.1",
    "loro-crdt": "^1.16.0",
    "marked": "^18.0.11",
    "mjml-browser": "^5.4.1",
    "nunjucks": "^3.2.4",
    "onnxruntime-web": "^1.29.0",
    "pg": "^8.23.0",
    "picomatch": "^4.0.2",
    "playwright": "^1.63.0",
