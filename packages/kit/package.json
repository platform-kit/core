{
  "name": "platformkit",
  "version": "0.1.0",
  "description": "PlatformKit: the engine and its default theme (Movable Types), one package. A site depends on it alone.",
  "type": "module",
  "license": "MIT",
  "repository": "github:platform-kit/core",
  "exports": {
    "./vite": "./vite/index.mjs",
    "./build/*": "./build/*",
    "./supabase/*": "./supabase/*",
    "./vendor/*": "./vendor/*",
    "./theme": "./theme/src/main.js",
    "./theme/*": "./theme/src/*",
    "./*": "./src/*"
  },
  "imports": {
    "#content": {
      "node": "./build/content-node.mjs",
      "default": "./.velite/index.js"
    },
    "#site": {
      "node": "./build/site-node.mjs",
      "default": "./build/site-node.mjs"
    },
    "#site/looks": {
      "node": "./build/site-looks-node.mjs",
      "default": "./build/site-looks-node.mjs"
    },
    "#site/landing": {
      "node": "./build/site-landing-node.mjs",
      "default": "./build/site-landing-node.mjs"
    },
    "#site/app": {
      "node": "./build/site-app-node.mjs",
      "default": "./build/site-app-node.mjs"
    },
    "#site/routes": {
      "node": "platformkit/build/site-routes-node.mjs",
      "default": "platformkit/build/site-routes-node.mjs"
    },
    "#site/nav": {
      "node": "platformkit/build/site-nav-node.mjs",
      "default": "platformkit/build/site-nav-node.mjs"
    },
    "#site/analytics": {
      "node": "platformkit/build/site-analytics-node.mjs",
      "default": "platformkit/build/site-analytics-node.mjs"
    },
    "#site/instrument": {
      "node": "platformkit/build/site-instrument-node.mjs",
      "default": "platformkit/build/site-instrument-node.mjs"
    },
    "#site/content/*": {
      "node": "platformkit/build/content-file-node.mjs",
      "default": "platformkit/build/content-file-node.mjs"
    },
    "#content/*": {
      "node": "platformkit/build/content-file-node.mjs",
      "default": "platformkit/build/content-file-node.mjs"
    },
    "#site/recommendations": {
      "node": "platformkit/build/site-recommendations-node.mjs",
      "default": "platformkit/build/site-recommendations-node.mjs"
    },
    "#site/permissions": {
      "node": "platformkit/build/site-permissions-node.mjs",
      "default": "platformkit/build/site-permissions-node.mjs"
    },
    "#site/desk": {
      "node": "platformkit/build/site-desk-node.mjs",
      "default": "platformkit/build/site-desk-node.mjs"
    },
    "#site/avatar": {
      "node": "platformkit/build/site-avatar-node.mjs",
      "default": "platformkit/build/site-avatar-node.mjs"
    },
    "#site/member": {
      "node": "platformkit/build/site-member-node.mjs",
      "default": "platformkit/build/site-member-node.mjs"
    },
    "#site/strings-default": {
      "node": "platformkit/build/site-strings-default-node.mjs",
      "default": "platformkit/build/site-strings-default-node.mjs"
    },
    "#site/admin": {
      "node": "platformkit/build/site-admin-node.mjs",
      "default": "platformkit/build/site-admin-node.mjs"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
