    "contentful": "^11.12.10",
    "contentful-management": "^11.76.0",
    "matrix-js-sdk": "^43.0.0",
    "posthog-js": "^1.428.3",
    "@calcom/embed-core": "^1.5.3",
    "@typeform/embed": "^6.0.0"
  }
}
