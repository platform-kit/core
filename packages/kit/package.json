    "vite-plugin-wasm": "^3.6.0",
    "vue": "^3.5.13",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "@primevue/themes": "^4.5.4",
    "@scalar/api-reference": "^1.70.0",
    "@templatical/editor": "^0.39.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-bold": "^2.27.3",
    "@tiptap/extension-document": "^2.27.3",
    "@tiptap/extension-hard-break": "^2.27.3",
    "@tiptap/extension-history": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-italic": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-paragraph": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-text": "^2.27.3",
    "@tiptap/extension-typography": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/vue-3": "^2.27.3",
    "@uppy/core": "^6.0.1",
    "@vueuse/core": "^14.4.0",
    "ag-grid-community": "^36.1.0",
    "ag-grid-vue3": "^36.1.0",
    "echarts": "^6.1.0",
    "livekit-client": "^2.22.3",
    "lucide-vue-next": "^1.0.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^4.10.38",
    "primevue": "^4.5.5",
    "tiptap-markdown": "^0.8.10",
    "vidstack": "^0.6.15",
    "vue-echarts": "^8.3.0",
    "vuedraggable": "^4.1.0",
    "vuefinder": "^4.7.6",
    "wavesurfer.js": "^7.12.12"
  },
  "peerDependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "ffmpeg-static": "^5.3.0",
    "mjml": "^5.4.1",
    "onnxruntime-node": "^1.29.0",
    "vue": "^3.5.13"
  },
  "bin": {
    "platformkit": "./bin/platformkit.mjs"
  },
  "files": [
    "bin",
    "build",
    "src",
    "supabase",
    "vendor",
    "vite",
    "README.md",
    "theme/src",
    "theme/README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    },
    "mjml": {
      "optional": true
    },
    "@myriaddreamin/typst-ts-node-compiler": {
      "optional": true
    },
    "@myriaddreamin/typst-ts-web-compiler": {
      "optional": true
    }
  },
