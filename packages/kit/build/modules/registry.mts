/*
 * The module registry (openspec: modules-as-packages): one file that imports each kit module folder's build-side
 * contributions by name, so the kit's ordered lists (the content models, the build steps) can take a moved module's
 * entries at its place — and so can an Edge Function, which cannot read folders.
 *
 * A module folder contributes through fixed entry files, each optional:
 *   build/models.mts   export default: its content models, in the order the admin rail shows them
 *   build/steps.mts    export default: its build steps, in declaration order
 *
 * The registry is written from the folders (`node build/modules/registry.mts --write`) and checked against them by
 * build/manifests.test.mts, so a folder and the registry can never disagree. Never edit modules/registry.mts by hand.
 */
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const KIT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..')
export const REGISTRY_FILE = path.join(KIT, 'modules/registry.mts')
const POINTS = [['models', 'build/models.mts'], ['steps', 'build/steps.mts']] as const

/* what the registry should say, from the folders as they are */
export function registrySource(): string {
  const root = path.join(KIT, 'modules')
  const keys = fs.existsSync(root) ? fs.readdirSync(root, { withFileTypes: true }).filter((d) => d.isDirectory() && fs.existsSync(path.join(root, d.name, 'module.ts'))).map((d) => d.name).sort() : []
  const id = (k: string) => k.replace(/-([a-z])/g, (_, c) => c.toUpperCase())
  const lines = ['/* GENERATED by build/modules/registry.mts from the module folders — do not edit; `node build/modules/registry.mts --write` */']
  const out: string[] = []
  for (const [point, file] of POINTS) {
    const has = keys.filter((k) => fs.existsSync(path.join(root, k, file)))
    for (const k of has) lines.push(`import ${id(k)}_${point} from './${k}/${file.replace(/\.mts$/, '.mjs')}'`)
    out.push(`export const ${point.toUpperCase()}: Record<string, any[]> = { ${has.map((k) => `${JSON.stringify(k)}: ${id(k)}_${point}`).join(', ')} }`)
  }
  return lines.join('\n') + '\n\n' + out.join('\n') + '\n'
}

if (process.argv.includes('--write')) {
  fs.writeFileSync(REGISTRY_FILE, registrySource())
  console.log('modules/registry.mts written')
}
