# PlatformKit workspace settings. Copy this file to .env and set only what the
# selected site and enabled modules need. Never put production credentials here.

# Local Supabase stack (supabase start). platformkit dev sets these per run.
# VITE_SUPABASE_URL: Supabase project origin used by the browser; platformkit dev sets it per
# run.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY: Public Supabase anon key for browser requests; never use the
# service-role key here.
VITE_SUPABASE_ANON_KEY=
# VITE_APP_URL: Public site origin used in auth links, checkout returns, and email links.
VITE_APP_URL=http://localhost:5173
# APP_URL: Public site origin used by functions when they create links back to the app.
APP_URL=http://localhost:5173
# VITE_STORE: Set false to omit the store chunk and send store routes to /; otherwise site
# module settings apply.
VITE_STORE=

# Model providers for content enrichment and agents. Keep keys blank unless
# you intend to make paid requests. Agent providers remain mocked unless
# AGENTS_LIVE=1 is explicitly set.
# ANTHROPIC_API_KEY: Anthropic credential for paid agent or enrichment calls; keep blank
# unless needed.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY: OpenAI credential for paid agent or enrichment calls; keep blank unless
# needed.
OPENAI_API_KEY=
# REPLICATE_API_TOKEN: Replicate credential for enrichment models that use Replicate; keep
# blank unless needed.
REPLICATE_API_TOKEN=
# AGENTS_LIVE: Set to 1 only when agent requests should use live providers instead of the
# local mock.
AGENTS_LIVE=

# Scheduling integration. The webhook secret must match the secret configured
# with the scheduling provider. Both are only required when the site enables
# the corresponding scheduling features.
# CAL_WEBHOOK_SECRET: Must match the scheduling provider webhook secret; needed only for
# published cal.com types.
CAL_WEBHOOK_SECRET=
# CAL_API_KEY: Server-side cal.com API credential; needed only when published booking types
# use cal.com.
CAL_API_KEY=

# Optional image search for the demo's image helper.
# UNSPLASH_ACCESS_KEY: the admin offers an Unsplash tab on every picture field; unset, the
# library is the only source and no tab is drawn. A free key from unsplash.com/developers;
# the server holds it, never the browser
UNSPLASH_ACCESS_KEY=

# Mail relay for account and site email. Locally, Mailpit can receive messages;
# production credentials belong in the deployment environment.
# SMTP_HOST: asked for only where something sends — accounts, the store, the chats, the
# funnels; a static site is asked for none of it — the mail relay (Mailgun's or any);
# SMTP_FROM is "Name <address>" on a verified domain. Locally, Mailpit's container on port
# 1025 with no login
SMTP_HOST=
# SMTP_PORT: asked for only where something sends — accounts, the store, the chats, the
# funnels; a static site is asked for none of it — the mail relay (Mailgun's or any);
# SMTP_FROM is "Name <address>" on a verified domain. Locally, Mailpit's container on port
# 1025 with no login
SMTP_PORT=587
# SMTP_USER: asked for only where something sends — accounts, the store, the chats, the
# funnels; a static site is asked for none of it — the mail relay (Mailgun's or any);
# SMTP_FROM is "Name <address>" on a verified domain. Locally, Mailpit's container on port
# 1025 with no login
SMTP_USER=
# SMTP_PASS: asked for only where something sends — accounts, the store, the chats, the
# funnels; a static site is asked for none of it — the mail relay (Mailgun's or any);
# SMTP_FROM is "Name <address>" on a verified domain. Locally, Mailpit's container on port
# 1025 with no login
SMTP_PASS=
# SMTP_FROM: asked for only where something sends — accounts, the store, the chats, the
# funnels; a static site is asked for none of it — the mail relay (Mailgun's or any);
# SMTP_FROM is "Name <address>" on a verified domain. Locally, Mailpit's container on port
# 1025 with no login
SMTP_FROM=
# SUPPORT_EMAIL: where the support digest goes (else every admin and support address)
SUPPORT_EMAIL=

# Local payment mocks complete the flow without contacting payment providers.
# Production deployment checks refuse mock settings.
# STRIPE_MOCK: checkout completes on the spot with Stripe's objects made up
STRIPE_MOCK=1
# PAYOUTS_MOCK: local only (the deploy refuses it): stands in for the two acts that touch the
# payment processor — a provider's account connects in one step and a transfer sends nothing
# — while the ledger is written exactly as it would be
PAYOUTS_MOCK=1
# VITE_STRIPE_PUBLISHABLE_KEY: Browser-safe Stripe publishable key for checkout; this is not
# the Stripe secret key.
VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY: anything for sale: a published priced offer, a book in print, a pricing
# row with a sku
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: anything for sale: a published priced offer, a book in print, a
# pricing row with a sku
STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY: server-side setting required only for incremental usage offers;
# it is returned to the authenticated customer only when card verification is needed.
STRIPE_PUBLISHABLE_KEY=

# Hyperswitch is selected with payments.provider: 'hyperswitch'. These credentials are
# server-side only; use the profile's payment_response_hash_key for its webhook secret.
HYPERSWITCH_BASE_URL=
HYPERSWITCH_API_KEY=
HYPERSWITCH_PROFILE_ID=
# Public key used by the Hyperswitch Web SDK; it is returned only for an active checkout.
HYPERSWITCH_PUBLISHABLE_KEY=
HYPERSWITCH_WEBHOOK_SECRET=
# Optional hosted Web SDK base URL; local self-hosted SDKs may use loopback HTTP.
HYPERSWITCH_CLIENT_URL=
# Router payment-method prefix (default v1, which the Hyperswitch Web SDK and Vault SDK guide use; the Router must match).
HYPERSWITCH_PAYMENT_METHODS_PREFIX=

# Deployment access. These are not needed for ordinary local development.
# SUPABASE_SERVICE_ROLE_KEY: the service-role key: the catalog is pushed with it, the
# functions write with it, the tts script uploads with it
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN: the CLI's personal token and the allow-listed production project
SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROD_REF: the CLI's personal token and the allow-listed production project
SUPABASE_PROD_REF=

# Optional sign-in providers; unset means off. Google also needs to be enabled
# in the Supabase project.
# VITE_AUTH_MAGIC_LINK: Set true to offer magic-link sign-in in the browser; otherwise that
# option is hidden.
VITE_AUTH_MAGIC_LINK=
# VITE_AUTH_GOOGLE: Set true to offer Google sign-in; the provider must also be enabled in
# Supabase.
VITE_AUTH_GOOGLE=

# Optional analytics. Unset, no analytics events are sent.
# VITE_POSTHOG_KEY: Optional browser analytics project key for sites that configure PostHog;
# blank disables it.
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST: Optional PostHog ingestion host for sites that configure PostHog.
VITE_POSTHOG_HOST=

# The browser voice is enabled by default when its module is on. Set false to
# disable it for a build. LOCKDOWN_MODE=1 closes the app to non-staff users.
# IN_BROWSER_TTS: false switches the person's in-browser voice off for everyone
IN_BROWSER_TTS=
# LOCKDOWN_MODE: 1 closes the built site to everyone but the staff
LOCKDOWN_MODE=

# Printer credentials. Blank keys use local mocks; sandbox credentials can be
# selected where supported. Production deployments refuse mock providers.
# LULU_CLIENT_KEY: a book in print: a printer for every printed format it sells (the one its
# block names; at least one for auto; Bookvault for premium)
LULU_CLIENT_KEY=
# LULU_CLIENT_SECRET: a book in print: a printer for every printed format it sells (the one
# its block names; at least one for auto; Bookvault for premium)
LULU_CLIENT_SECRET=
# LULU_SANDBOX: a book in print: a printer for every printed format it sells (the one its
# block names; at least one for auto; Bookvault for premium)
LULU_SANDBOX=
# LULU_MOCK: every printer call (or one printer's) answered locally; a mock order walks to
# shipped
LULU_MOCK=1
# MIXAM_USER: a book in print: a printer for every printed format it sells (the one its block
# names; at least one for auto; Bookvault for premium)
MIXAM_USER=
# MIXAM_PASS: a book in print: a printer for every printed format it sells (the one its block
# names; at least one for auto; Bookvault for premium)
MIXAM_PASS=
# MIXAM_UK: a book in print: a printer for every printed format it sells (the one its block
# names; at least one for auto; Bookvault for premium)
MIXAM_UK=
# BOOKVAULT_API_KEY: a book in print: a printer for every printed format it sells (the one
# its block names; at least one for auto; Bookvault for premium)
BOOKVAULT_API_KEY=

# Web push. Generate a VAPID pair for a deployment; never reuse private keys
# from another environment.
# VITE_VAPID_PUBLIC_KEY: Public VAPID key delivered to browsers so they can subscribe to web
# push.
VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY: Secret VAPID key used by the server to sign web-push requests; never
# expose it to the browser.
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: Contact URI sent to web-push services as the VAPID sender identity.
VAPID_SUBJECT=mailto:hello@example.com

# Optional developer account recreated by a local database reset. Local only;
# the reset refuses to use these settings against a remote database.
# DEV_ACCOUNT: Email of the account recreated by a local database reset; refused for
# non-local databases.
DEV_ACCOUNT=
# DEV_ACCOUNT_NAME: Optional display name for the local reset account; defaults to the email
# name.
DEV_ACCOUNT_NAME=
# DEV_ACCOUNT_PASSWORD: Optional password for the local reset account; defaults to the seed
# password.
DEV_ACCOUNT_PASSWORD=
# DEV_ACCOUNT_ROLES: Comma-separated roles for the local reset account; defaults to admin.
DEV_ACCOUNT_ROLES=
# DEV_ACCOUNT_ROLE: Single-role compatibility setting for the local reset account;
# DEV_ACCOUNT_ROLES takes precedence.
DEV_ACCOUNT_ROLE=

# Optional integrations. Configure only the providers enabled by the selected
# site's modules; the reference guide explains when each setting is required.
# AGENT_API_BASE: an OpenAI-shaped endpoint other than OpenAI's — Azure, Groq, Together,
# OpenRouter, vLLM, Ollama. Defaults to https://api.openai.com/v1
AGENT_API_BASE=
# AGENT_API_KEY: where bots buy their thinking; OPENAI_API_KEY is used when it is unset. With
# neither, bots answer from the mock
AGENT_API_KEY=
# AGENT_MAX_TOKENS: the longest answer Anthropic may give (its API requires a limit; 4096 by
# default)
AGENT_MAX_TOKENS=4096
# AGENT_MODEL: the model a bot uses when its own file does not name one
AGENT_MODEL=
# AGENT_PROVIDERS: the order, by name (anthropic,openai). Anything not named is left out.
# Default: the OpenAI-shaped one, then Anthropic
AGENT_PROVIDERS=

# Optional local Hyperswitch v2 integration tests. Never put provider credentials
# in this file; the integration runner accepts a separate private profile file.
# HYPERSWITCH_SOURCE_DIR: Hyperswitch source checkout used to build the Docker test stack.
HYPERSWITCH_SOURCE_DIR=
# PLATFORMKIT_HYPERSWITCH_TEST_PORT: loopback port for the test router; defaults to 18323.
PLATFORMKIT_HYPERSWITCH_TEST_PORT=18323
# PLATFORMKIT_HYPERSWITCH_TEST_PROJECT: isolated Docker Compose project name.
PLATFORMKIT_HYPERSWITCH_TEST_PROJECT=platformkit-hyperswitch-test
# HYPERSWITCH_LOCAL_INTEGRATION_CONFIG: private .env or JSON profile file for the live runner.
HYPERSWITCH_LOCAL_INTEGRATION_CONFIG=
# ANTHROPIC_API_BASE: somewhere other than https://api.anthropic.com
ANTHROPIC_API_BASE=
# ANTHROPIC_MODEL: what the fallback uses. It uses its OWN model, never the one asked for: a
# model is a provider's own word, and sending gpt-4o-mini to Anthropic is a second failure
# rather than a fallback
ANTHROPIC_MODEL=
# CAL_API_BASE: where the kit's cal.com client points (https://api.cal.com/v2 by default):
# another site's Scheduling API, https://<their domain>/v2, books there instead — the closed
# loop the test runs against the site itself
CAL_API_BASE=https://api.cal.com/v2
# COMPANION_MODEL: the enrichment's model
COMPANION_MODEL=
# COMPANION_THINKING: the enrichment's model
COMPANION_THINKING=
# COPILOT_BASE_URL: optional LiveKit worker completion base URL; if unset, the worker uses
# APP_URL plus /v1
COPILOT_BASE_URL=
# COPILOT_TTS_KEY: an OpenAI-shaped /v1/audio/speech the site is heard in instead of the
# kit's own voice. The key stays here and never reaches the browser; with neither set the
# page speaks for itself
COPILOT_TTS_KEY=
# COPILOT_TTS_MODEL: which model and voice that endpoint is asked for (tts-1, alloy)
COPILOT_TTS_MODEL=tts-1
# COPILOT_TTS_URL: an OpenAI-shaped /v1/audio/speech the site is heard in instead of the
# kit's own voice. The key stays here and never reaches the browser; with neither set the
# page speaks for itself
COPILOT_TTS_URL=
# COPILOT_TTS_VOICE: which model and voice that endpoint is asked for (tts-1, alloy)
COPILOT_TTS_VOICE=alloy
# COPILOT_TURN_MS: maximum time the Copilot completion function waits for one turn; defaults
# to 60 seconds
COPILOT_TURN_MS=60000
# FORMS_WEBHOOK_SECRET: the key a form's webhook deliveries are signed with
# (X-Form-Signature); else derived from the service key
FORMS_WEBHOOK_SECRET=
# LINKEDIN_API_VERSION: optional LinkedIn API version; the adapter uses its supported default
# when unset
LINKEDIN_API_VERSION=
# MATRIX_FN_URL: where that lane looks for the served function; the local stack’s address by
# default
MATRIX_FN_URL=
# NETWORK_APPVIEW_DID: the app view a joined member reads the world outside through, and the
# DID its service tokens are addressed to; the config's network.appview and
# did:web:api.bsky.app unless set
NETWORK_APPVIEW_DID=
# NETWORK_APPVIEW_URL: the app view a joined member reads the world outside through, and the
# DID its service tokens are addressed to; the config's network.appview and
# did:web:api.bsky.app unless set
NETWORK_APPVIEW_URL=
# NETWORK_FEDERATE: makes the atproto function federate whatever the config says — a local
# stack's tests only; the deploy refuses it
NETWORK_FEDERATE=
# NETWORK_HANDLE_DOMAIN: the domain every member's handle sits under (<username>.<domain>),
# with a wildcard DNS record and certificate pointing at the site; needed while the network
# module is on, whether or not the site federates (a closed site answers its own members'
# apps under it). Atproto reserves .localhost, so a local stack uses a name such as
# network.test; unset, the function falls back to the site's own host name
NETWORK_HANDLE_DOMAIN=
# NETWORK_PLC_ROTATION_KEY: the secret key that controls the portable identity made for each
# member who joins the wider network; needed only where network.federate is on, and never
# rotated away
NETWORK_PLC_ROTATION_KEY=
# NETWORK_PLC_URL: the PLC directory a joined member's identity is made at;
# https://plc.directory unless set — a local stack points it at a stand-in, never at the real
# directory, where an identity is permanent
NETWORK_PLC_URL=https://plc.directory
# NETWORK_RELAY_URL: the relay asked to crawl the site when a member joins and once a day;
# the config's network.relay (Bluesky's) unless set, and none asks nobody
NETWORK_RELAY_URL=
# PRINTIFY_API_KEY: a published product using Printify as its supplier; PRINTIFY_MOCK=1 is
# local-only and makes supplier calls mock responses
PRINTIFY_API_KEY=
# PRINTIFY_MOCK: Set to 1 to mock Printify supplier requests locally; deploys refuse mock
# providers.
PRINTIFY_MOCK=
# PRINTIFY_SHOP_ID: a published product using Printify as its supplier; PRINTIFY_MOCK=1 is
# local-only and makes supplier calls mock responses
PRINTIFY_SHOP_ID=
# PUBLIC_FUNCTIONS_URL: the functions on the site's own domain (https://<site>/v1), with the
# host's rewrite; off by default
PUBLIC_FUNCTIONS_URL=
# REDDIT_USER_AGENT: optional Reddit API identification string; the generic kit value is used
# when unset
REDDIT_USER_AGENT=
# STORAGE_S3_ACCESS_KEY: a room type that records: the film lands in the recordings bucket
# through Storage's S3 endpoint (STORAGE_S3_ENDPOINT, STORAGE_S3_REGION optional, defaulting
# to the project's own)
STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_ENDPOINT: Optional Storage S3 endpoint for LiveKit recordings; defaults to this
# project endpoint.
STORAGE_S3_ENDPOINT=
# STORAGE_S3_REGION: Optional Storage S3 region for LiveKit recordings; defaults to
# us-east-1.
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_SECRET_KEY: a room type that records: the film lands in the recordings bucket
# through Storage's S3 endpoint (STORAGE_S3_ENDPOINT, STORAGE_S3_REGION optional, defaulting
# to the project's own)
STORAGE_S3_SECRET_KEY=
# VAPID_PUBLIC_KEY: Public half of the VAPID key pair used to identify the web-push sender.
VAPID_PUBLIC_KEY=
# VITE_BANK_SHEET: a site with an instrument: swap the statement bank from a Google Sheet
# without a release
VITE_BANK_SHEET=
# VITE_PUBLIC_FUNCTIONS_URL: the functions on the site's own domain (https://<site>/v1), with
# the host's rewrite; off by default
VITE_PUBLIC_FUNCTIONS_URL=
# VITE_SUPABASE_STUDIO_URL: the local Studio's address, linked from the admin
VITE_SUPABASE_STUDIO_URL=
# WEBRTC_STUN: where a browser finds its own public address, comma separated; a default is
# used when it is unset
WEBRTC_STUN=
# WEBRTC_TURN_PASSWORD: the same, with the long-term credentials some relays hand out instead
WEBRTC_TURN_PASSWORD=
# WEBRTC_TURN_SECRET: a relay for the two people in a call who cannot reach each other
# directly — a coturn the site runs, or anything that speaks the standard. The function mints
# <expiry>:<person> and its HMAC; nothing is required and no provider is named
WEBRTC_TURN_SECRET=
# WEBRTC_TURN_URL: the same, with the long-term credentials some relays hand out instead
WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME: the same, with the long-term credentials some relays hand out instead
WEBRTC_TURN_USERNAME=

# Optional build, CLI, and publishing settings. Leave unset for the defaults.
# CONTENT_ENGINE: Choose velite or collections for the content build; velite is the default.
CONTENT_ENGINE=
# CONTENT_STORE: Set to cloud to use row-backed content; otherwise the deployment setting
# selects the content source.
CONTENT_STORE=
# DEPLOY: Set to 1 to authorize the deploy script to proceed after its preflight checks.
DEPLOY=
# FFMPEG: a path to ffmpeg, when not the machine's or ffmpeg-static
FFMPEG=
# NVM_DIR: the nvm installation directory (~/.nvm by default), used when the platformkit CLI
# restarts under Node 22 because npm run dev started with another Node version
NVM_DIR=
# PLAYWRIGHT_CHROMIUM_PATH: the build without the prerender or the images; a browser of your
# own
PLAYWRIGHT_CHROMIUM_PATH=
# PLATFORMKIT_BUILD_HEAP: Maximum old-space heap for the build, in MB (3072 by default); use
# off to keep Node default.
PLATFORMKIT_BUILD_HEAP=
# PRERENDER: the build without the prerender or the images; a browser of your own
PRERENDER=
# PRINT_BUILD: Set to 1 to enable print-specific build work where configured.
PRINT_BUILD=
# PRINT_COMMIT: a title made at the printer committed back
PRINT_COMMIT=
# PRINT_DRIVER: which Typst compiles a book: node (the default, the native compiler on a
# machine) or wasm (the same compiler built for an Edge Function, where a cloud-only site has
# nothing else). Both set the same edition — build/print-parity.test.mjs is what holds them
# to it
PRINT_DRIVER=
# PRINT_GITHUB_TOKEN: GitHub token used by print registry commits when the build machine has
# no Git credentials.
PRINT_GITHUB_TOKEN=
# PRINT_NO_SHOTS: skip the page pictures on the listing. They are photographed by pdf.js in a
# headless Chromium, which a function has not got, so they are best-effort: a cloud-only site
# gets the book and the EPUB and no page pictures. The edition is the same either way — they
# are a listing nicety and never part of the book
PRINT_NO_SHOTS=
# PRINT_PARTS: say what an edition's hash is made of, part by part, as each book is set — the
# templates, the typeset source, the trim, the bindings, the colours, the picture. It is how
# you answer "why did this book come out as a different edition in the cloud?" without
# diffing a typeset source by eye; the function answers the same thing when a call asks for
# parts
PRINT_PARTS=
# PRINT_TEST_BOOK: which book print-cloud.test.mjs sets against the running stack;
# the-golden-key by default
PRINT_TEST_BOOK=
# SHARE_FONT: optional font family for generated share-card images; defaults to Newsreader
SHARE_FONT=
# SHARE_IMAGES: the build without the prerender or the images; a browser of your own
SHARE_IMAGES=
# SITE_URL: Optional canonical site URL used by site-facing build or test tooling.
SITE_URL=
# SUPABASE_ANON_KEY: Public Supabase anon key accepted by local tools; never use the
# service-role key here.
SUPABASE_ANON_KEY=
# SUPABASE_DB_URL: Production database session-pooler URL used by the schema plan;
# percent-encode the password.
SUPABASE_DB_URL=
# SUPABASE_URL: Supabase project origin used by server-side tools and functions.
SUPABASE_URL=
# PLATFORMKIT_SHADOW_DB_URL: Disposable shadow Postgres URL reset to the schema declaration;
# never point it at production or valuable data.
PLATFORMKIT_SHADOW_DB_URL=
# TTS: Set to 1 in deployment to run the optional full spoken-book sync; unset by default.
TTS=
# TTS_BITRATE: the voice and its settings (a change renames every recording)
TTS_BITRATE=
# TTS_COMMIT: a tts run commits and pushes its store; a build box's token; the committer it
# signs as
TTS_COMMIT=
# TTS_COMMIT_BRANCH: a tts run commits and pushes its store; a build box's token; the
# committer it signs as
TTS_COMMIT_BRANCH=
# TTS_COMMIT_EMAIL: a tts run commits and pushes its store; a build box's token; the
# committer it signs as
TTS_COMMIT_EMAIL=
# TTS_COMMIT_NAME: a tts run commits and pushes its store; a build box's token; the committer
# it signs as
TTS_COMMIT_NAME=
# TTS_GAP: the silence between spoken pieces, in seconds
TTS_GAP=
# TTS_GITHUB_TOKEN: GitHub token used by spoken-book sync when it must fetch or push Git LFS
# objects.
TTS_GITHUB_TOKEN=
# TTS_SPEED: the voice and its settings (a change renames every recording)
TTS_SPEED=
# TTS_STEPS: the voice and its settings (a change renames every recording)
TTS_STEPS=
# TTS_THREADS: the voice and its settings (a change renames every recording)
TTS_THREADS=
# TTS_VOICE: the voice and its settings (a change renames every recording)
TTS_VOICE=
# PLATFORMKIT_ALLOW_DESTRUCTIVE: Explicit consent for destructive schema plans; normally
# leave blank and use exact plan approval.
PLATFORMKIT_ALLOW_DESTRUCTIVE=
# PLATFORMKIT_ICONS_ALL: Set to 1 to build every Lucide glyph instead of only icons used by
# content.
PLATFORMKIT_ICONS_ALL=
# PLATFORMKIT_VERBOSE: Set to 1 to print detailed build/deploy output, including full plans
# and emitted files.
PLATFORMKIT_VERBOSE=

# Site-specific managed Git remotes use this pattern. Replace <NAME> with the
# uppercase site name, replacing hyphens with underscores.
# PLATFORMKIT_SITE_<NAME>_GIT_URL: Git URL for a managed site; replace NAME with its
# uppercase directory name, using underscores for hyphens.
# PLATFORMKIT_SITE_<NAME>_GIT_URL=
# Private GitHub fetches can use PLATFORMKIT_GITHUB_TOKEN, GITHUB_TOKEN, or
# GH_TOKEN; tokens are passed to Git temporarily and never stored in the URL.
# PLATFORMKIT_GITHUB_TOKEN: GitHub token for private managed-site fetches/updates; passed to
# Git temporarily, never stored in the URL.
PLATFORMKIT_GITHUB_TOKEN=
# GITHUB_TOKEN: Fallback GitHub token for private managed-site fetches/updates; passed to Git
# temporarily.
GITHUB_TOKEN=
# GH_TOKEN: Alternate fallback GitHub token for private managed-site fetches/updates; passed
# to Git temporarily.
GH_TOKEN=

# Multiple-site host and workspace configuration. These are normally unset for
# a single-site checkout; see the multiple-sites reference before enabling.
# PLATFORMKIT_APEX: the selected site that also answers the bare domain; www redirects to its
# subdomain. Unset, the bare domain and www return 404
PLATFORMKIT_APEX=
# PLATFORMKIT_DEFAULT_SITE: site used by root CLI and npm site commands, and by workspace
# development when no explicit multi-site selection is set; defaults to sites/docs. It may
# name a site or give a path to a tracked, fetched, or separately linked site; --site takes
# precedence
PLATFORMKIT_DEFAULT_SITE=
# PLATFORMKIT_DOMAIN: the parent domain that enables named site hosts; use localhost in
# development and the real domain in production. Unset, the existing single-site host stays
# in place
PLATFORMKIT_DOMAIN=
# PLATFORMKIT_ROOT_SITE: optional DNS name for a site configured at the checkout root, which
# has no directory name; the tooling-only root is not a site and this is normally unset
PLATFORMKIT_ROOT_SITE=
# PLATFORMKIT_SITES: comma-separated site names to include. In workspace development, an
# explicit value selects a multi-site set and takes precedence over PLATFORMKIT_DEFAULT_SITE;
# in production files mode it is required so a fixture or other unselected site is never
# published
PLATFORMKIT_SITES=
# PLATFORMKIT_SITES_MODE: proxy for the local Vite front door or files for built production
# sites; defaults to files
PLATFORMKIT_SITES_MODE=

# Optional local probes and test controls. Test flags set to 0 skip that
# focused test; *_SHOTS values name output directories for browser captures.
# AGENT_TEST: skips the agent loop's database test (a run answered, a worker killed mid-run
# and picked up by another, a cancel that stops a tool before it runs, a budget that holds)
# in platformkit test; it skips itself when the stack or the functions are down
AGENT_TEST=
# ANALYTICS_TEST: skips the database half of the analytics test (the channel rule, the
# audience partition, recirculation, right now, the channels over the seed) in platformkit
# test; the arrival parser is still checked; it skips itself when the stack is down
ANALYTICS_TEST=
# ATPROTO_INTEROP_TEST: skip the federation's interop test; the port its PLC directory
# listens on (2582, and its app view the next) — it skips itself when the function does not
# federate
ATPROTO_INTEROP_TEST=
# ATPROTO_PLC_PORT: skip the federation's interop test; the port its PLC directory listens on
# (2582, and its app view the next) — it skips itself when the function does not federate
ATPROTO_PLC_PORT=
# ATPROTO_TEST: skips the atproto test (the network as an atproto server, driven by Bluesky's
# own client against the served function) in platformkit test; it skips itself when the
# function is not served
ATPROTO_TEST=
# AWARDS_TEST: skips the achievements and traits database test (the event stream awarding a
# badge when its rule is met and not before, and a client able neither to award itself one
# nor to read what the site believes about it) in platformkit test; it skips itself when the
# stack is down
AWARDS_TEST=
# BROWSER_WAIT_MS: the floor on every browser timeout in the repository, set on each context
# by build/browser.mjs. Default 60000. Playwright’s own default is 30000 and applies to any
# call given no explicit budget, so a file that writes 60 on the waits it thought about still
# ran the rest at 30 — and under load those are the ones that fail. One number, and it is a
# minimum: a call that needs longer still passes its own
BROWSER_WAIT_MS=60000
# COMMENTS_TEST: skips the comments' database test (who is held and who is not, the flagged
# word beating trust, what an approval writes down, the embed's three declarations) in
# platformkit test; it skips itself when the stack is down
COMMENTS_TEST=
# COMMUNITY_TEST: skips the community's database test (the three kinds in one instance,
# invitations, moderating and inviting as grants, the four acts, the mute as a fence) in
# platformkit test; it skips itself when the stack is down
COMMUNITY_TEST=
# CONTENT_API_TEST: skips the content index test (every published entry rendered, an
# unpublished one absent, the ids stable) in platformkit test
CONTENT_API_TEST=
# COPILOT_TEST: skips what a person told an assistant being theirs (the policies, the recall
# floor, the deletion) in platformkit test; it skips itself when the stack is down
COPILOT_TEST=
# DESK_TEST: skips the staff desk's database test (three sources in one list, each answered
# where it lives, and nothing of anyone's disclosed to somebody) in platformkit test; it
# skips itself when the stack is down
DESK_TEST=
# ENCRYPTION_TEST: skips the encryption test (what a sealed message leaves in the row and in
# the index, and that the seal is one-way) in platformkit test; it skips itself when the
# stack is down
ENCRYPTION_TEST=
# FORMS_API_SHOTS: a directory the Forms API test writes its embed screenshot into (none by
# default)
FORMS_API_SHOTS=
# FORMS_API_TEST: skips the Forms API test (the shapes, the official client against the
# served function, the webhooks, the embed) in platformkit test
FORMS_API_TEST=
# FUNNELS_TEST: skips the funnel analytics test (the journey and the conversions against the
# local stack's seed, the unsubscribe link against the served function) in platformkit test;
# it skips itself when the stack is down
FUNNELS_TEST=
# HOLDS_TEST: skips the holds test (nobody's time taken twice: the hold written with the
# booking, two at the same instant, a group holding its host once) in platformkit test; it
# skips itself when the stack is down
HOLDS_TEST=
# HUDDLE_APP: where that two-browser call looks for the site, when it is not
# http://localhost:5173
HUDDLE_APP=
# HUDDLE_LIVE: skips the two-browser call in the huddle test (the rest of it still runs); it
# skips itself when no dev server answers
HUDDLE_LIVE=
# HUDDLE_ROOM: the room it opens, as a path (/spaces/<space>/<channel>); by default the
# site's staff space and its general
HUDDLE_ROOM=
# IDENTITY_PROBE: skip the identity probe (build/identity-probe.mjs — does signing in on a
# page give you the page reloading it gives?). It is not in npm test: it wants a browser, a
# dev server and a couple of minutes
IDENTITY_PROBE=
# IDENTITY_PROBE_PASS: who it signs in as (default the seed's member@example.com /
# password123)
IDENTITY_PROBE_PASS=
# IDENTITY_PROBE_ROUTES: which routes it asks about, comma separated (default
# /spaces,/app,/app/chat,/content,/store)
IDENTITY_PROBE_ROUTES=
# IDENTITY_PROBE_USER: who it signs in as (default the seed's member@example.com /
# password123)
IDENTITY_PROBE_USER=
# IDENTITY_PROBE_WAIT: milliseconds to let a surface settle before it is read (default 6000)
IDENTITY_PROBE_WAIT=
# INTERACTION_URL: where the interaction lane (build/interaction.test.mjs) finds the site to
# use — a browser that types into the palette, sends a line from the support widget, answers
# a diagnostic screen and opens the bag, with the console watched. Default
# http://localhost:5173; --url overrides it. With nothing serving there the lane skips loudly
# rather than passing
INTERACTION_URL=http://localhost:5173
# INTERACTION_WAIT_MS: how long the interaction lane waits for any condition before giving
# up. Default 60000 — generous on purpose, since the lane drives a real browser while the
# rest of the suite loads the same machine, and a timeout tuned to an idle laptop makes it
# fail for reasons that have nothing to do with the site
INTERACTION_WAIT_MS=60000
# INVENTORY_TEST: skips the stock test (the decrement racing two connections for the last
# unit, reservations, a refund putting the count back) in platformkit test; it skips itself
# when the stack is down, naming what it did not cover
INVENTORY_TEST=
# MATRIX_API_TEST: 0 skips the Matrix lane’s live half, as the other API lanes are skipped
MATRIX_API_TEST=
# NETWORK_TEST: skips the network's database tests (the audiences, a reply never wider than
# its post, blocks and mutes, the timeline, moderation — and the community's one notification
# list) in platformkit test; it skips itself when the stack is down
NETWORK_TEST=
# ORDERS_TEST: skips the orders test (the transactions summing to the total and refused at
# the write, fulfilment and payment derived rather than stored, an edit raising the version,
# stock coming back on received and never on requested) in platformkit test; it skips itself
# when the stack is down, naming what it did not cover
ORDERS_TEST=
# PAYOUTS_TEST: skips the ledger's database test (the sweep run twice, the delay, and a
# refund either side of the window) in platformkit test; it skips itself when the stack is
# down
PAYOUTS_TEST=
# PEOPLE_TEST: skips the People panel's database test (every account, one person's whole
# picture, and never the last administrator away) in platformkit test; it skips itself when
# the stack is down
PEOPLE_TEST=
# PLATFORMKIT_TEST_FUNCTIONS_URL: optional functions base URL for the live webhook-door test;
# defaults to the local Supabase URL plus /functions/v1
PLATFORMKIT_TEST_FUNCTIONS_URL=
# PLATFORMKIT_TEST_API_URL: optional Supabase API origin for webhook-door assertions; defaults
# to SUPABASE_URL
PLATFORMKIT_TEST_API_URL=
# PLATFORMKIT_TEST_ANON_KEY: optional anon key for the audio-bucket policy probe; defaults to
# VITE_SUPABASE_ANON_KEY
PLATFORMKIT_TEST_ANON_KEY=
# PLATFORMKIT_TEST_SERVICE_ROLE_KEY: optional service-role key for webhook-door assertions and
# cleanup; defaults to the local test key
PLATFORMKIT_TEST_SERVICE_ROLE_KEY=
# POLICY_TEST: skips the policies test (who may read what, against the local stack's seed) in
# platformkit test; it skips itself when the stack is down
POLICY_TEST=
# PROMO_TEST: skips the discount-budget test (a limit counted in the database, and ten
# checkouts racing for three remaining uses) in platformkit test; it skips itself when the
# stack is down, naming what it did not cover
PROMO_TEST=
# PROVIDERS_TEST: skips the stack half of the providers test (a signed version frozen, who is
# owed the new one, an offering theirs and never deleted, failing to sign stopping selling
# and nothing else) in platformkit test; the pure half still runs, and it skips itself when
# the stack is down
PROVIDERS_TEST=
# RECOMMENDATIONS_TEST: skips the recommendations test (what somebody is interested in,
# against the local stack: a re-tagged piece changing it with nothing re-run, a partial read
# counting, a purchase outweighing browsing) in platformkit test; it skips itself when the
# stack is down
RECOMMENDATIONS_TEST=
# REWRITES_TEST: skips the rewrites test (the nginx instance in Docker against the local
# stack) in platformkit test; it skips itself when Docker or the stack is down
REWRITES_TEST=
# SCHEDULING_API_SHOTS: a directory the Scheduling API test writes its embed screenshots into
# (none by default)
SCHEDULING_API_SHOTS=
# SCHEDULING_API_TEST: skips the Scheduling API test (the shapes, cal.js pointed at the site,
# the judge, the webhooks, cal.com's embed) in platformkit test
SCHEDULING_API_TEST=
# SCHEMA_TEST: skips the schema test in platformkit test
SCHEMA_TEST=
# SDK_TEST: skips the analytics script's test (the built file loaded in a headless page
# against the served ingest door: PostHog's surface, the size, a page view, identify, an
# opted-out page, PostHog's snippet) in platformkit test; it skips itself when the stack is
# down
SDK_TEST=
# SOCIAL_TEST_MAILPIT_URL: the social invitation integration test’s local Mailpit URL;
# defaults to the stack’s Mailpit port
SOCIAL_TEST_MAILPIT_URL=
# SPACES_TEST: skips the spaces' database test (the fill sweep, the isolation, the counters
# against a walk, the cursor, the live topic) in platformkit test; it skips itself when the
# stack is down
SPACES_TEST=
# SQL_COLUMNS: skips the column guard (every column a SQL function names, against the kit's
# and the site's declarations read as one) in platformkit test; it needs no database
SQL_COLUMNS=
# STOREFRONT_API_SHOTS: a directory the Store API test writes the handoff page's screenshots
# into (none by default)
STOREFRONT_API_SHOTS=
# STOREFRONT_API_TEST: skips the Store API test (the products and the schema, the official
# client against the served function, the cart, the checkout url followed) in platformkit
# test
STOREFRONT_API_TEST=
# SUPPORT_API_SHOTS: a directory the Support API test writes the snippet's screenshots into
# (none by default)
SUPPORT_API_SHOTS=
# SUPPORT_API_TEST: skips the Support API test (the shapes, the Client and Application APIs,
# the webhooks, the snippet) in platformkit test
SUPPORT_API_TEST=
# TEAMS_TEST: skips the teams membership test (the rule filling a team, an invitation
# surviving a change to the rule, a membership that is not a directory) in platformkit test;
# it skips itself when the stack is down
TEAMS_TEST=
# WEBHOOKS_TEST: skips the shipped-subscriptions test (declared, pushed, a secret from the
# environment, one made by hand untouched) in platformkit test; it skips itself when the
# stack is down
WEBHOOKS_TEST=
# WH_TEST_SECRET: set by that test alone, to prove a secret reaches a subscription from the
# environment and never from the file; nothing else reads it
WH_TEST_SECRET=
# PLATFORMKIT_SHARE_STACK: Set to 1 to run the optional share-sidecar check against a real
# compose stack.
PLATFORMKIT_SHARE_STACK=
# PLATFORMKIT_SKIP_CLOUD_LANE: Set to 1 to skip the cloud publish-cycle test lane; the run
# reports this as skipped.
PLATFORMKIT_SKIP_CLOUD_LANE=
# PLATFORMKIT_SKIP_STATIC_LANE: Set to 1 to skip the slow static-site test lane; the run
# reports this as skipped.
PLATFORMKIT_SKIP_STATIC_LANE=

# Local-only provider mocks and agent controls. Deploy checks reject mocks.
# BOOKVAULT_MOCK: every printer call (or one printer's) answered locally; a mock order walks
# to shipped
BOOKVAULT_MOCK=
# LIVEKIT_MOCK: the site's video rooms on a LiveKit dev server (LIVEKIT_MOCK_API its address
# from the functions, http://host.docker.internal:7880 by default) and a recording a fixture
# film the mock lands
LIVEKIT_MOCK=
# LIVEKIT_MOCK_API: HTTP address of the local LiveKit mock server; defaults to
# host.docker.internal:7880.
LIVEKIT_MOCK_API=
# MIXAM_MOCK: every printer call (or one printer's) answered locally; a mock order walks to
# shipped
MIXAM_MOCK=
# PLATFORMKIT_AGENT_MOCK: every bot answers from a script instead of a model, so nothing is
# bought. A run that carries a script is never bought anyway, whatever this says
PLATFORMKIT_AGENT_MOCK=
# PRINT_MOCK: every printer call (or one printer's) answered locally; a mock order walks to
# shipped
PRINT_MOCK=

# LiveKit is optional: without it, small rooms use peer-to-peer calls and are
# not recorded. Add credentials only for the room features that require them.
# LIVEKIT_API_KEY: a published booking type in a video room that records or seats more than
# five, or the optional Copilot reader transport; the three values are required together
LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET: a published booking type in a video room that records or seats more
# than five, or the optional Copilot reader transport; the three values are required together
LIVEKIT_API_SECRET=
# LIVEKIT_URL: a published booking type in a video room that records or seats more than five,
# or the optional Copilot reader transport; the three values are required together
LIVEKIT_URL=

# Internal markers managed by PlatformKit. These are documented for
# completeness; do not set them manually. GIT_CONFIG_COUNT is used only for
# temporary child-process Git configuration; NODE_OPTIONS is read from Node.
# GIT_CONFIG_COUNT: Git temporary-configuration counter adjusted internally for authenticated
# fetches; do not set manually.
GIT_CONFIG_COUNT=
# NODE_OPTIONS: Optional Node.js runtime flags; an explicit max-old-space-size here overrides
# the build heap setting.
NODE_OPTIONS=
# PLATFORMKIT_CONTENT_DONE: Internal build handoff marker set by platformkit build; do not
# set manually.
PLATFORMKIT_CONTENT_DONE=
# PLATFORMKIT_DEV_DIRECTORY: Internal workspace development switch set by the runner; do not
# enable in production.
PLATFORMKIT_DEV_DIRECTORY=
# PLATFORMKIT_DEV_DIRECTORY_PORT: Internal port allocated for the workspace directory server;
# do not set manually.
PLATFORMKIT_DEV_DIRECTORY_PORT=
# PLATFORMKIT_DEV_PARENT_PID: Internal parent process id passed to managed site dev servers;
# do not set manually.
PLATFORMKIT_DEV_PARENT_PID=
# PLATFORMKIT_DEV_PARENT_RUN_ID: Internal workspace-run marker passed to managed site
# servers; do not set manually.
PLATFORMKIT_DEV_PARENT_RUN_ID=
# PLATFORMKIT_DEV_RUN_ID: Internal ownership id assigned to a managed development run; do not
# set manually.
PLATFORMKIT_DEV_RUN_ID=
