# generated by packages/kit/build/rewrites.mjs from deploy/_redirects — never edited by hand (node packages/kit/build/rewrites.mjs writes it; --check holds it)
# one location per rule, in the file's order; nginx fills ${SUPABASE_URL} from the environment at start (the image's envsubst on /etc/nginx/templates)

# the content API — Contentful's Delivery, Preview, Sync and GraphQL (api + a content kind)   contentful.js: createClient({ host: <site>, basePath: '/api/content' })
location = /api/content {
  try_files /api/content/index.html /index.html;
}
location ^~ /api/content/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/content/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# the media API — the images door, whose urls the content API writes (api + a content kind)
location = /api/media {
  try_files /api/media/index.html /index.html;
}
location ^~ /api/media/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/images/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# the desk — Chatwoot's Client API, Application API and website snippet (api + support)   chatwootSDK.run({ baseUrl: '<site>/api/desk' }); the snippet's script is a file of the build
location = /api/desk/packs/js/sdk.js {
  try_files /packs/js/sdk.js =404;
}

location = /api/desk {
  try_files /api/desk/index.html /index.html;
}
location ^~ /api/desk/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/support-api/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# the scheduling API — cal.com's v2 (api + sessions); the base is <site>/api/scheduling/v2
location = /api/scheduling {
  try_files /api/scheduling/index.html /index.html;
}
location ^~ /api/scheduling/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/scheduling-api/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# the forms API — Typeform's (api + forms); @typeform/api-client: apiBaseUrl: '<site>/api/forms'
location = /api/forms {
  try_files /api/forms/index.html /index.html;
}
location ^~ /api/forms/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/forms-api/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# the events API — every event, the site's own and a registered source's, in PostHog's wire protocol (always); a PostHog SDK: api_host: '<site>/api/events'
location ^~ /api/events/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/ingest/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}

location = /api/events {
  proxy_pass ${SUPABASE_URL}/functions/v1/ingest;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# the store API — Shopify's Storefront endpoint and the handoff's cart read (api + store)
location = /api/store {
  try_files /api/store/index.html /index.html;
}
location ^~ /api/store/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/storefront-api/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# THE STORE'S ALIAS, and the reason it is the last rule under /api: @shopify/storefront-api-client takes a storeDomain and throws away any path on it — given <site>/api/store it asks for <site>/api/<version>/graphql.json regardless. So the same door is served there too, and its second segment being a version is why nothing else may sit under /api without a room. build/storefront-api.test.mjs pins the client's behaviour, so the alias cannot be removed without a failing test saying why it was there.
location = /api {
  try_files /api/index.html /index.html;
}
location ^~ /api/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/storefront-api/api/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# THE SOCIAL NETWORK'S DOORS (the network module). An atproto client — Bluesky's app, or any other — asks /xrpc/<method> at the ROOT of the host it was given, and resolves a member's handle at that host's /.well-known; neither can carry a room under /api, so these three are the one place a protocol's own path stands at the root. A site with the network off has none of them.
location = /xrpc {
  try_files /xrpc/index.html /index.html;
}
location ^~ /xrpc/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/atproto/xrpc/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}

location = /.well-known/atproto-did {
  proxy_pass ${SUPABASE_URL}/functions/v1/atproto/.well-known/atproto-did;
  include /etc/nginx/conf.d/functions-proxy.inc;
}

location = /.well-known/did.json {
  proxy_pass ${SUPABASE_URL}/functions/v1/atproto/.well-known/did.json;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
# THE APP CALLING ITS OWN BACKEND IS NOT AN API and has no room: /v1/<function> is the Edge Functions gateway on this site's domain (the v1 is Supabase's, not ours), so the browser reaches every function same-origin and without a preflight, and a link a function writes into an email points at this site rather than at supabase.co. It is what PUBLIC_FUNCTIONS_URL names. It can never be renamed: the tracked links, the open pixel and the unsubscribe link in marketing email already sent are written as <site>/v1/… and are sitting in people's inboxes.
location = /v1 {
  try_files /v1/index.html /index.html;
}
location ^~ /v1/ {
  proxy_pass ${SUPABASE_URL}/functions/v1/;
  include /etc/nginx/conf.d/functions-proxy.inc;
}
