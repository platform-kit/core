# how every rewrite reaches the functions: the project's host as the Host header (its TLS certificate names it),
# SNI on, HTTP/1.1, the caller's address and scheme carried, no buffering of a long answer (a signed file, a redirect)
proxy_set_header Host ${SUPABASE_HOST};
proxy_ssl_server_name on;
proxy_http_version 1.1;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_buffering off;
proxy_read_timeout 120s;
