{
  "name": "@platform-kit/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The PlatformKit demo: a generic site with every module on, no code of its own.",
  "scripts": {
    "dev": "platformkit dev",
    "build": "platformkit build",
    "preview": "vite preview --host",
    "test": "platformkit test",
    "db:reset": "platformkit migrate reset",
    "db:serve": "platformkit functions"
  },
  "dependencies": {
    "platformkit": "0.1.0",
    "@templatical/renderer": "^0.39.0",
    "cheerio": "^1.2.0",
    "mjml": "^5.4.1",
    "mjml-browser": "^5.4.1"
  },
  "imports": {
    "#content": {
      "node": "platformkit/build/content-node.mjs",
      "default": "./.velite/index.js"
    },
    "#content/*": "./.velite/*",
    "#site/content/*": "./content/*",
    "#site": {
      "node": "platformkit/build/site-node.mjs",
      "default": "platformkit/build/site-node.mjs"
    },
    "#site/looks": {
      "node": "platformkit/build/site-looks-node.mjs",
      "default": "platformkit/build/site-looks-node.mjs"
    },
    "#site/landing": {
      "node": "platformkit/build/site-landing-node.mjs",
      "default": "platformkit/build/site-landing-node.mjs"
    },
    "#site/app": {
      "node": "platformkit/build/site-app-node.mjs",
      "default": "platformkit/build/site-app-node.mjs"
    },
    "#site/routes": {
      "node": "platformkit/build/site-routes-node.mjs",
      "default": "platformkit/build/site-routes-node.mjs"
    },
    "#site/nav": {
      "node": "platformkit/build/site-nav-node.mjs",
      "default": "platformkit/build/site-nav-node.mjs"
    },
    "#site/analytics": {
      "node": "platformkit/build/site-analytics-node.mjs",
      "default": "platformkit/build/site-analytics-node.mjs"
    },
    "#site/instrument": {
      "node": "platformkit/build/site-instrument-node.mjs",
      "default": "platformkit/build/site-instrument-node.mjs"
    },
    "#site/recommendations": {
      "node": "platformkit/build/site-recommendations-node.mjs",
      "default": "platformkit/build/site-recommendations-node.mjs"
    },
    "#site/admin": {
      "node": "platformkit/build/site-admin-node.mjs",
      "default": "platformkit/build/site-admin-node.mjs"
    }
  }
}
