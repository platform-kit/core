VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173
STRIPE_MOCK=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# the local stack signs its own test webhooks with this (recordings.test.mjs posts a signed RECORDING_READY); production sets its own
CAL_WEBHOOK_SECRET=local-demo-webhook-secret
# a placeholder key: the recordings test stands in for cal.com's API on the local stack; production sets its own
CAL_API_KEY=local-demo-key
# the site's own video rooms: UNSET, a room is the mesh — browser to browser, no account, nothing recorded, five people.
# Set these three to hold rooms on LiveKit instead. Locally the dev server is the account to point at, and the mock lands
# a fixture film: docker run --name lk-dev -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server \
#   --keys "devkey: secretsecretsecretsecretsecretsecret" --node-ip 127.0.0.1   (LIVEKIT_URL=ws://127.0.0.1:7880)
# Production sets the three and the STORAGE_S3_* pair, so a recording lands by Egress over Storage.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
